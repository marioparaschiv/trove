{
  "name": "@trove/obsidian",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "lint": "biome check .",
    "test": "cargo build --quiet --package trove && node --test src/*.test.ts",
    "build": "tsc && bun run bundle",
    "bundle": "bun build src/main.ts --outfile main.js --target node --format cjs --external obsidian --external electron --env 'TROVE_RELEASE_*'"
  },
  "dependencies": {
    "@trove/client": "workspace:*"
  },
  "devDependencies": {
    "obsidian": "^1.14.4"
  }
}
